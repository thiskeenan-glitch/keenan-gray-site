{
  "version": 2,
  "builds": [
    {
      "src": "api/audit.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/workspace/?$",
      "dest": "/public/client.html"
    },
    {
      "src": "^/workspace/expert/?$",
      "dest": "/public/workspace.html"
    },
    {
      "src": "^/workspace/contributors/?$",
      "dest": "/public/contributors.html"
    },
    {
      "src": "^/api/audit/?$",
      "dest": "/api/audit.js"
    },
    {
      "src": "^/(style\\.css|app\\.js|client\\.css|client\\.js|contributor-engine\\.mjs|contributor-ui\\.mjs)$",
      "dest": "/public/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
